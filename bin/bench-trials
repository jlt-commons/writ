#!/bin/sh
# Benchmark the prover over the trial projects' specs (bench/trials): the
# corpus the solver's work is judged on. Extra arguments go to writ.bench,
# for example --baseline bench/trials-baseline.edn.
set -e
cd "$(dirname "$0")/.."
exec jolt -M:bench:trials "$@" booking.core-spec orders.core-spec bucket.core-spec library.core-spec
